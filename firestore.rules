rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "asikosman010@gmail.com" ||
         request.auth.token.email == "admin@porterslakedental.com");
    }

    function isValidBooking(data) {
      return data.patientName is string && 
             data.patientEmail is string && 
             (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected' || data.status == 'cancelled');
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (isAuthenticated() && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if isValidBooking(request.resource.data) && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
  }
}
