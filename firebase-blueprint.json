{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information with role-based access control",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User access role" }
      },
      "required": ["name", "email", "role"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Dental appointment booking request",
      "type": "object",
      "properties": {
        "patientName": { "type": "string", "description": "Full name of the patient" },
        "patientEmail": { "type": "string", "format": "email", "description": "Email address of the patient" },
        "patientPhone": { "type": "string", "description": "Phone number of the patient" },
        "service": { "type": "string", "description": "Requested dental service" },
        "date": { "type": "string", "description": "Appointment date in YYYY-MM-DD" },
        "time": { "type": "string", "description": "Appointment time slot (e.g. 09:00 AM)" },
        "appointmentStartAt": { "type": "string", "format": "date-time", "description": "Canonical UTC appointment start time" },
        "appointmentEndAt": { "type": "string", "format": "date-time", "description": "Canonical UTC appointment end time" },
        "reminderDueAt": { "type": "string", "format": "date-time", "description": "UTC timestamp when 24h reminder is due" },
        "timeZone": { "type": "string", "description": "Clinic time zone (America/Halifax)" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"], "description": "Status of the booking" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the booking was created" }
      },
      "required": ["patientName", "patientEmail", "patientPhone", "service", "date", "time", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User account profiles with role elevation security"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Appointment records accessible strictly to authorized administrators"
    }
  }
}
